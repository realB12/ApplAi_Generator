# Required
VITE_SUPABASE_URL=https://<your-project>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>

# Optional
VITE_APP_NAME=Applai Resume Generator
VITE_HCAPTCHA_SITEKEY=10000000-ffff-ffff-ffff-000000000001
VITE_SENTRY_DSN=

# TestMode (dev-only; structurally disabled in production builds regardless
# of these values — see DEV_GUIDES/Architecture/TestMode-Concept.md and
# src/config/testmode.ts). Put real values in your own .env.local, never here.
VITE_TESTMODE=yes
VITE_TEST_LOG_LEVEL=debug
VITE_TEST_AUTH_PREFILL=yes
VITE_TEST_DEBUG_PANEL=yes

# CR003: required for TestMode to activate at all (config/testmode.ts Layer 0
# gate). Must match a REAL user in your Supabase project. Never commit real
# values — placeholders only.
VITE_TEST_USER_MAIL=tester@example.com
VITE_TEST_USER_PW=Test1234567!
